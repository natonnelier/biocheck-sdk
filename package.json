{
  "name": "biocheck-sdk",
  "version": "0.1.0",
  "description": "Browser-based biometric identity verification SDK",
  "type": "module",
  "main": "./dist/biocheck-sdk.umd.cjs",
  "module": "./dist/biocheck-sdk.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/biocheck-sdk.js",
      "require": "./dist/biocheck-sdk.umd.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.18",
    "mrz": "^4.0.0",
    "onnxruntime-web": "^1.20.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-wasm": "^3.3.0",
    "vitest": "^2.0.0"
  }
}
